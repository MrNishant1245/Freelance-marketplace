PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/freelance_marketplace

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@freelancemarketplace.com
EMAIL_FROM_NAME=Freelance Marketplace

# Client URL (for email links)
CLIENT_URL=http://localhost:3000

# Cloudinary (for profile photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# WebRTC TURN Server (Optional for strict firewalls/NATs e.g. Metered.ca)
TURN_URL=turn:relay.metered.ca:80
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# Twilio Network Traversal (Optional dynamic TURN)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agora RTC Calling (Optional)
AGORA_APP_ID=8a61421f108d4b31a8b981f211eb5a7c
AGORA_APP_CERTIFICATE=


